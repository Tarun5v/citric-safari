{
  "manifest_version": 3,
  "name": "Citric",
  "version": "1.0.14",
  "description": "A clean, lightweight, open-source YouTube player for Safari, in the spirit of Vinegar.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.0"
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ]
}